# A change to any of these needs a code owner's approval (ADR 0005, 0006).
# They are the rules and the checks that enforce them: an agent must not be
# able to make a failing check pass by editing the check.
# Enforced by branch protection on main: code owner review, and approvals
# are dismissed when new commits are pushed. .claude/settings.json asks
# before editing exactly these paths (tooling/scripts/check-agent-files.ts).

# Dependencies and supply chain
/package.json               @mdrepo
/bun.lock                   @mdrepo
/bunfig.toml                @mdrepo
/dependency-allowlist.json  @mdrepo
/turbo.json                 @mdrepo

# CI, hooks, the check scripts and the build
/.github/                   @mdrepo
/.githooks/                 @mdrepo
/tooling/                   @mdrepo
/.gitleaks.toml             @mdrepo

# Lint, format, type and dead-code rules
/eslint.config.js           @mdrepo
/tsconfig.base.json         @mdrepo
/knip.json                  @mdrepo
/.prettierignore            @mdrepo

# Decisions, design and agent guidance
/docs/adr/                  @mdrepo
/DESIGN.md                  @mdrepo
/AGENTS.md                  @mdrepo
/CLAUDE.md                  @mdrepo
/.claude/                   @mdrepo
/.agents/                   @mdrepo

# What "correct" means: specs and tests. An owner approves every change to
# them, so an agent can't redefine success to match its code (ADR 0002).
/specs/                     @mdrepo

# Each workspace's manifest, config, build scripts and tests (ADR 0016).
# agents:check fails if a workspace has one of these that isn't listed.
/apps/web/package.json              @mdrepo
/apps/web/tsconfig.json             @mdrepo
/apps/web/playwright.config.ts      @mdrepo
/apps/web/wrangler.jsonc            @mdrepo
/apps/web/scripts/                  @mdrepo
/apps/web/test/                     @mdrepo
/apps/web/e2e/                      @mdrepo
/packages/engine/package.json       @mdrepo
/packages/engine/tsconfig.json      @mdrepo
/packages/engine/test/              @mdrepo
/packages/ui/package.json           @mdrepo
/packages/ui/tsconfig.json          @mdrepo
/packages/ui/tokens/                @mdrepo
/packages/ui/test/                  @mdrepo
/packages/usecases/package.json     @mdrepo
/packages/usecases/tsconfig.json    @mdrepo
/packages/data/package.json         @mdrepo
/packages/data/tsconfig.json        @mdrepo
/apps/kit/package.json              @mdrepo
/apps/kit/tsconfig.json             @mdrepo
/apps/kit/playwright.config.ts      @mdrepo
/apps/kit/scripts/                  @mdrepo
/apps/kit/e2e/                      @mdrepo
