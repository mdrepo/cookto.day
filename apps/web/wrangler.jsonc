// The site, and the API beside it (ADR 0025). dist/ is the site's files; the
// Worker in apps/api answers /api/* only, so every other request is a file,
// served without running any of our code. Deployed by
// .github/workflows/deploy.yml on every merge to main (ADR 0017), never by
// hand from a laptop.
{
  "$schema": "https://unpkg.com/wrangler@4.147.0/config-schema.json",
  "name": "cookto-day",
  "main": "../api/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // One counter for every AI read (ADR 0028), in its own SQLite storage.
  "durable_objects": {
    "bindings": [{ "name": "USAGE", "class_name": "UsageCounter" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UsageCounter"] }],
  // Receipt photos stay off until sign-in ships, then a PR turns them on.
  // Keys and tokens are Worker secrets, saved by the owner with
  // apps/api/scripts/secret.sh, never here (ADR 0030).
  "vars": {
    "RECEIPT_PHOTOS": "off",
    "RECEIPT_MODEL": "gemini-2.5-flash-lite",
  },
  // The messenger's outbox is drained every minute, and its housekeeping
  // runs at 3 UTC (ADR 0031, apps/api/src/index.ts).
  "triggers": { "crons": ["* * * * *", "0 3 * * *"] },
  "routes": [{ "pattern": "cookto.day", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
}
