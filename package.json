{
  "name": "cookto.day",
  "version": "0.1.0",
  "private": true,
  "description": "What to cook today, from the groceries you already have. A boilerplate for AI contributions, with an app to prove it.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build && bun run --cwd apps/kit build",
    "e2e": "bun run --cwd apps/web e2e && bun run --cwd apps/kit e2e && bun run --cwd packages/data-web e2e",
    "typecheck": "TURBO_TELEMETRY_DISABLED=1 turbo run typecheck",
    "lint": "TURBO_TELEMETRY_DISABLED=1 turbo run lint",
    "test": "TURBO_TELEMETRY_DISABLED=1 turbo run test",
    "check": "bun run check:repo && TURBO_TELEMETRY_DISABLED=1 turbo run typecheck lint test",
    "check:affected": "bun run check:repo && TURBO_TELEMETRY_DISABLED=1 turbo run typecheck lint test --affected && bun run --cwd tooling test",
    "check:repo": "bun run deps:check && bun run agents:check && bun run design:check && bun run size:check && bun run packs:check && bun run words:check && bun run format:check && bun run knip",
    "deps:check": "bun tooling/scripts/check-dependency-allowlist.ts",
    "deps:health": "bun tooling/scripts/check-dependency-health.ts",
    "agents:check": "bun tooling/scripts/check-agent-files.ts",
    "design:check": "bun tooling/scripts/check-design.ts",
    "size:check": "bun tooling/scripts/check-file-size.ts",
    "packs:check": "bun tooling/scripts/check-packs.ts && bun tooling/scripts/packs-bundle.ts --check",
    "packs:bundle": "bun tooling/scripts/packs-bundle.ts",
    "packs:refresh": "bun tooling/scripts/packs-refresh.ts",
    "words:check": "bun tooling/scripts/check-words.ts",
    "city": "bun city/scripts/city.ts",
    "copies": "bun tooling/scripts/copies.ts",
    "tokens": "bun tooling/scripts/tokens.ts",
    "new": "bun tooling/scripts/new.ts",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "tdd:verify": "bun tooling/scripts/tdd-verify.ts",
    "review": "bun tooling/scripts/review.ts",
    "mutate": "bun tooling/scripts/mutate.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261009.1",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "@types/node": "26.1.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "happy-dom": "21.0.4",
    "knip": "6.38.0",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "trustedDependencies": [],
  "workspaces": [
    "apps/*",
    "packages/*",
    "city",
    "db",
    "tooling"
  ],
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  }
}
