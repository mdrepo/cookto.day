{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {},
    "apps/web": {
      "entry": ["src/main.tsx", "src/react.ts", "scripts/*.ts"],
      "project": [
        "src/**/*.{ts,tsx}",
        "test/**/*.ts",
        "e2e/**/*.ts",
        "scripts/**/*.ts"
      ]
    },
    "apps/kit": {
      "entry": ["scripts/*.ts", "src/page.tsx"],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/engine": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/ui": {
      "entry": ["src/components/*/*.kit.tsx"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"]
    },
    "tooling": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts", "test/**/*.ts"]
    }
  },
  "ignoreExportsUsedInFile": true
}
