#!/bin/sh
# ADR 0008: unit tests, the TDD check and e2e before code leaves your machine.
# CI repeats everything except e2e (ADR 0004), so e2e only runs here.
set -eu

zero=0000000000000000000000000000000000000000
changed=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a branch
  # What this branch changes against main, whether or not it was pushed
  # before: after a rebase the old remote tip would count everything main
  # gained, and a docs branch would run the browser suite.
  base=$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "")
  if [ -n "$base" ]; then
    changed="$changed$(git diff --name-only "$base" "$local_sha")
"
  else
    changed="${changed}unknown
"
  fi
done

[ -z "$changed" ] && exit 0

# Only words changed: nothing that ships, nothing a test checks. CI still
# runs every check on the PR (ADR 0017).
if ! printf '%s' "$changed" | grep -Ev '^(docs/|specs/|.*\.md$)' | grep -q .; then
  echo "pre-push: only docs changed, nothing to run"
  exit 0
fi

echo "pre-push: unit tests, in every workspace"
bun run --silent test

if [ -f tooling/scripts/tdd-verify.ts ]; then
  echo "pre-push: tdd:verify"
  bun run --silent tdd:verify
fi

if printf '%s' "$changed" | grep -Eq '^(apps/|packages/|package\.json$|bun\.lock$|unknown$)'; then
  echo "pre-push: e2e (an app, a package it may use, its tests or its build changed)"
  bun run e2e
fi
